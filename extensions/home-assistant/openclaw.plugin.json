{
  "id": "home-assistant",
  "activation": {
    "onStartup": false
  },
  "providerAuthEnvVars": {
    "home-assistant": ["HASS_URL", "HASS_TOKEN"]
  },
  "uiHints": {
    "url": {
      "label": "Home Assistant URL",
      "help": "Base URL of your Home Assistant instance (e.g. http://192.168.1.100:8123). Fallback: HASS_URL env var.",
      "placeholder": "http://192.168.1.100:8123"
    },
    "token": {
      "label": "Long-Lived Access Token",
      "help": "A long-lived access token from your Home Assistant profile page. Fallback: HASS_TOKEN env var.",
      "sensitive": true,
      "placeholder": "eyJhbGciOi..."
    }
  },
  "contracts": {
    "tools": [
      "hass_get_states",
      "hass_get_entity",
      "hass_call_service",
      "hass_get_services",
      "hass_get_history"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "url": {
        "type": ["string", "object"]
      },
      "token": {
        "type": ["string", "object"]
      },
      "timeout": {
        "type": "number",
        "minimum": 1,
        "maximum": 120,
        "description": "Request timeout in seconds (default: 15)"
      }
    }
  }
}
